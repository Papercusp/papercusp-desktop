{
  "name": "@papercusp/desktop",
  "version": "0.0.4",
  "private": true,
  "description": "Tauri desktop shell for Papercusp. Spawns the Node sidecar and embeds the web UI.",
  "scripts": {
    "tauri": "tauri",
    "dev": "bin/desktop-dev-nohmr",
    "dev:nohmr": "bin/desktop-dev-nohmr",
    "dev:preview": "bin/desktop-preview-prod",
    "test:fed-asserts": "bash bin/lib/federation-asserts.selftest.sh",
    "test:federation:live-matrix": "bash bin/deb-hetzner-matrix.sh",
    "test:rust": "node ../scripts/report-cargo-tests.mjs --manifest-path papercusp-desktop/src-tauri/Cargo.toml",
    "dev:hmr": "tauri dev --config '{\"build\":{\"devUrl\":\"http://localhost:3055\"}}'",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "build:archived": "bash bin/build-and-archive-deb.sh",
    "test:config": "node --test test/tauri-config-resources.test.js",
    "bindings": "cd src-tauri && cargo build --quiet && (cargo run --quiet 2>/dev/null & PID=$!; sleep 4; kill $PID 2>/dev/null; wait $PID 2>/dev/null; true) && echo '\u2713 tauri-bindings.ts regenerated'"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  },
  "dependencies": {
    "jq": "^1.7.2"
  }
}
