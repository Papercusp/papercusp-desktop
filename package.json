{
  "name": "@papercusp/desktop",
  "version": "0.0.13",
  "private": true,
  "description": "Tauri desktop shell for Papercusp. Spawns the Node sidecar and embeds the web UI.",
  "scripts": {
    "test": "npm run test:config && npm run test:shell && npm run test:selftests",
    "tauri": "tauri",
    "dev": "bin/desktop-dev-nohmr",
    "dev:nohmr": "bin/desktop-dev-nohmr",
    "dev:quickpanel": "PAPERCUSP_DEV_OPEN_QUICK_PANEL=only bin/desktop-dev-nohmr",
    "dev:preview": "bin/desktop-preview-prod",
    "test:fed-asserts": "bash bin/lib/federation-asserts.selftest.sh",
    "test:release-artifacts": "bash bin/lib/release-artifacts.selftest.sh",
    "test:gen-latest-manifest": "bash bin/lib/gen-latest-manifest.selftest.sh",
    "test:live-fed-reaper": "bash bin/lib/live-federation-gate-reaper.selftest.sh",
    "test:release-leg-reaper": "bash bin/lib/release-local-leg-reaper.selftest.sh",
    "test:local-matrix-starvation": "bash bin/lib/local-matrix-starvation.selftest.sh",
    "test:rig-bank-logs": "bash bin/lib/rig-bank-logs.selftest.sh",
    "test:seat-offer-diag": "bash bin/lib/seat-offer-diag.selftest.sh",
    "test:b9-attestation-precondition": "bash bin/lib/b9-attestation-precondition.selftest.sh",
    "test:vm-run-env": "bash bin/lib/vm-run-env.selftest.sh",
    "test:restart-settle-barrier": "bash bin/lib/restart-settle-barrier.selftest.sh",
    "test:rig-wait-converged": "bash bin/lib/rig-wait-converged.selftest.sh",
    "test:roster-scope": "bash bin/lib/roster-scope.selftest.sh",
    "test:selftests": "bash bin/lib/run-selftests.sh",
    "test:sidecar-lock": "node --test test/build-desktop-sidecar-lock.test.js",
    "test:dev-operator-reaper": "node --test test/dev-operator-ifneeded-reaper.test.js",
    "test:stale-sidecar-guard": "node --test test/build-deb-stale-sidecar-guard.test.js",
    "test:deb-bundle-lock-path": "node --test test/build-deb-bundle-lock-path.test.js",
    "test:deb-build-timeout": "node --test test/build-deb-build-timeout.test.js",
    "test:installed-app-tree": "node --test test/installed-app-tree.test.js",
    "test:stray-cache-guard": "node --test test/sidecar-stray-cache-guard.test.js",
    "test:shell": "node --test test/build-desktop-sidecar-lock.test.js test/dev-operator-ifneeded-reaper.test.js test/build-deb-stale-sidecar-guard.test.js test/build-deb-bundle-lock-path.test.js test/build-deb-build-timeout.test.js test/installed-app-tree.test.js test/sidecar-stray-cache-guard.test.js",
    "test:updater-e2e-vm": "node --test test/updater-e2e-vm.test.js",
    "test:federation:live-matrix": "bash bin/deb-hetzner-matrix.sh",
    "test:rust": "node ../scripts/report-cargo-tests.mjs --manifest-path papercusp-desktop/src-tauri/Cargo.toml",
    "dev:hmr": "tauri dev --config '{\"build\":{\"devUrl\":\"http://localhost:3055\"}}'",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "build:archived": "bash bin/build-and-archive-deb.sh",
    "test:config": "node --test test/tauri-config-resources.test.js",
    "bindings": "cd src-tauri && cargo build --quiet && (cargo run --quiet 2>/dev/null & PID=$!; sleep 4; kill $PID 2>/dev/null; wait $PID 2>/dev/null; true) && echo '\u2713 tauri-bindings.ts regenerated'"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  },
  "dependencies": {}
}
