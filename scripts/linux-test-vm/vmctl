#!/usr/bin/env bash
# vmctl — Papercusp Linux clean-room test VM control.
#
# A disposable Ubuntu 24.04 VM for (1) fresh-install testing the packaged .deb on a
# pristine system and (2) acting as a separate machine for shared-harness/federation
# testing. Plan: linux-test-vm-and-federation-2026-06-04.
#
#   vmctl provision               build the golden image (one-time, ~10–20 min)
#   vmctl up    [name]            boot a VM (overlay off golden); default name "clean"
#   vmctl down  [name]            graceful shutdown
#   vmctl reset [name]            recreate a pristine overlay from golden
#   vmctl ssh   [name] [cmd...]   shell / run a command in the VM
#   vmctl install [name] [deb]    scp the newest .deb in + apt install (fresh-install test)
#   vmctl launch  [name]          start the installed app in the VM's GUI session
#   vmctl hotpatch [name] [serve.mjs]  swap ONLY the sidecar bundle + relaunch (fast
#                                 JS iteration; no .deb rebuild). Records provenance.
#   vmctl updater-e2e APPIMAGE    reset the dedicated VM and launch an isolated
#                                 updater/revert baseline (never host PID space)
#   vmctl gui     [name]          open a SPICE viewer (run this yourself; opens a window)
#   vmctl gui-paste [name] TEXT   paste exact text into the focused guest field and capture it
#   vmctl verify  [name]          assert install/PG/operator/window; capture logs+screenshot
#   vmctl status  [name]          VM up? app up? operator :3070? disk free?
#   vmctl endpoint [name]         print ssh_port= / ssh_key= / ssh_host= (the ONE source
#                                 other tools derive this VM's SSH endpoint from)
#   vmctl is-running [name]       exit 0 when the instance's qemu is alive, 1 otherwise
#   vmctl wait-ssh [name] [sec]   block until SSH answers; exit 1 after the budget
#   vmctl help

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"
SELF_DIR="$SCRIPT_DIR"

# ── provision ──────────────────────────────────────────────────────────────
cmd_provision() {
  local force=0; [ "${1:-}" = "--force" ] && force=1
  mkdir -p "$IMAGES_DIR" "$RUN_DIR"

  if [ ! -f "$SSH_KEY" ]; then
    log "generating SSH key $SSH_KEY"
    ssh-keygen -t ed25519 -N '' -f "$SSH_KEY" -C papercup-vm-linux >/dev/null
  fi

  if [ ! -f "$BASE_IMG" ]; then
    log "downloading Ubuntu 24.04 cloud image → $BASE_IMG"
    wget --progress=dot:giga -O "$BASE_IMG.part" "$UBUNTU_IMG_URL"
    mv "$BASE_IMG.part" "$BASE_IMG"
  fi
  [ "$(stat -c%s "$BASE_IMG")" -gt 100000000 ] || die "base image looks truncated: $BASE_IMG"

  if [ -f "$GOLDEN" ] && [ "$force" -ne 1 ]; then
    die "golden already exists ($GOLDEN). Re-provision with: vmctl provision --force"
  fi
  log "building golden.qcow2 from base (resize → $DISK_SIZE)"
  rm -f "$GOLDEN"
  qemu-img convert -O qcow2 "$BASE_IMG" "$GOLDEN"
  qemu-img resize "$GOLDEN" "$DISK_SIZE"

  # Render the cloud-init seed (inject our pubkey).
  local pdir="$RUN_DIR/_provision"; mkdir -p "$pdir"
  local ud="$pdir/user-data" seed; seed="$pdir/seed.iso"
  sed "s#__SSH_PUBKEY__#$(cat "$SSH_KEY.pub")#" \
      "$SELF_DIR/cloud-init/user-data.tmpl" > "$ud"
  cloud-localds "$seed" "$ud" "$SELF_DIR/cloud-init/meta-data"

  # Boot golden directly with the seed (under the "clean" port slot).
  log "first boot of golden with cloud-init seed (installs the desktop — slow)"
  BOOT_DISK="$GOLDEN" BOOT_SEED="$seed" bash "$SELF_DIR/boot-vm.sh" clean

  wait_ssh clean 600 || die "VM never came up for SSH during provisioning (see $(vm_serial clean))"
  log "cloud-init running — waiting for completion (ubuntu-desktop-minimal install)…"
  vm_ssh clean 'cloud-init status --wait' || warn "cloud-init --wait returned non-zero"
  local ci; ci="$(vm_ssh clean 'cloud-init status' 2>/dev/null || true)"
  log "cloud-init: $ci"
  case "$ci" in
    *done*) log "provisioning OK" ;;
    *error*) die "cloud-init reported an error — golden is half-built. Inspect: vmctl ssh clean 'sudo cloud-init status --long'" ;;
    *) warn "cloud-init status unclear ($ci) — continuing, verify manually" ;;
  esac

  log "powering off the golden VM"
  vm_ssh clean 'sudo systemctl poweroff' 2>/dev/null || true
  local w=0; while vm_running clean && [ "$w" -lt 120 ]; do sleep 3; w=$((w+3)); done
  vm_running clean && { warn "VM still up — forcing"; kill "$(vm_pid clean)" 2>/dev/null || true; }
  rm -f "$(vm_pidfile clean)" "$(vm_monitor clean)"

  log "GOLDEN READY: $GOLDEN"
  log "next: vmctl up clean && vmctl install clean && vmctl verify clean"
}

# ── lifecycle ──────────────────────────────────────────────────────────────
ensure_overlay() {  # ensure_overlay <name>
  local name="$1" ov; ov="$(vm_overlay "$name")"
  require_golden
  mkdir -p "$(vm_rundir "$name")"
  if [ ! -f "$ov" ]; then
    log "creating overlay for $name (backed by golden)"
    qemu-img create -f qcow2 -b "$GOLDEN" -F qcow2 "$ov" >/dev/null
  fi
}

is_federation_vm_name() {
  case "$1" in
    fed-*) return 0 ;;
    *)     return 1 ;;
  esac
}

require_federation_boot_context() {
  local name="$1"
  is_federation_vm_name "$name" || return 0
  if [ -z "${FED_NIC:-}" ] || [ -z "${SLIRP_NET:-}" ]; then
    die "refusing to boot federation VM $name without FED_NIC + SLIRP_NET — use papercusp-desktop/bin/vm-federation.sh (add --no-reset --skip-install to reuse an overlay); plain 'vmctl up $name' cannot create a peerable rig"
  fi
}

require_federation_launch_context() {
  local name="$1"
  is_federation_vm_name "$name" || return 0
  vm_ssh "$name" '
    test -s "$HOME/fed.env" &&
      grep -q "^GH_TOKEN=." "$HOME/fed.env" &&
      {
        grep -q "^PAPERCUSP_DHT_BOOTSTRAP=." "$HOME/fed.env" ||
          grep -qx "PAPERCUSP_FED_DHT_MODE=public" "$HOME/fed.env"
      }
  ' 2>/dev/null || die "refusing to launch federation VM $name without a validated ~/fed.env (GitHub identity plus an isolated DHT bootstrap or explicit public mode) — use papercusp-desktop/bin/vm-federation.sh"
}

cmd_up() {
  local name="${1:-clean}"
  require_federation_boot_context "$name"
  ensure_overlay "$name"
  bash "$SELF_DIR/boot-vm.sh" "$name"
  wait_ssh "$name" 180 || warn "SSH not up yet — check 'vmctl status $name' / $(vm_serial "$name")"
}

cmd_down() {
  local name="${1:-clean}"
  vm_running "$name" || { log "$name not running"; return 0; }
  log "shutting down $name (pid $(vm_pid "$name"))"
  vm_ssh "$name" 'sudo systemctl poweroff' 2>/dev/null || true
  local w=0; while vm_running "$name" && [ "$w" -lt 60 ]; do sleep 3; w=$((w+3)); done
  if vm_running "$name"; then
    warn "graceful shutdown timed out — SIGTERM"; kill "$(vm_pid "$name")" 2>/dev/null || true
    sleep 3; vm_running "$name" && kill -9 "$(vm_pid "$name")" 2>/dev/null || true
  fi
  rm -f "$(vm_pidfile "$name")" "$(vm_monitor "$name")"
  log "$name down"
}

cmd_reset() {
  local name="${1:-clean}"
  cmd_down "$name"
  local ov; ov="$(vm_overlay "$name")"
  rm -f "$ov"
  ensure_overlay "$name"
  log "$name reset to a pristine overlay. Boot it with: vmctl up $name"
}

cmd_ssh() { local name="${1:-clean}"; shift || true; vm_ssh "$name" "$@"; }

# ── install / launch / gui (P-004) ─────────────────────────────────────────
cmd_install() {
  local name="${1:-clean}" deb="${2:-}"
  [ -n "$deb" ] || deb="$(default_deb)"
  [ -n "$deb" ] && [ -f "$deb" ] || die "no .deb found. Build one or pass a path: vmctl install $name <deb>"
  vm_running "$name" || die "$name is not running. vmctl up $name"
  log "copying $(basename "$deb") ($(du -h "$deb" | cut -f1)) into $name…"
  vm_scp "$name" "$deb" /tmp/Papercusp.deb
  log "apt install (resolving runtime deps — the fresh-install test)…"
  # --reinstall so a SAME-version rebuilt .deb (version stays 0.0.1) is actually
  # re-laid-down on a --no-reset overlay; without it apt skips "already newest"
  # and a code-only rebuild silently wouldn't land. On a pristine overlay it's a
  # plain install (nothing to reinstall).
  # A Server install leaves a detached, best-effort ghostty apt worker behind.
  # The supported immediately-following GUI install used to wait only on
  # /var/lib/dpkg/lock-frontend, but its FIRST command is `apt-get update`, which
  # instead failed on /var/lib/apt/lists/lock while that worker was active. Wait
  # for the complete apt/dpkg lock set plus the owning processes to stay idle for
  # two consecutive probes before BOTH apt phases. Keep apt's native dpkg waiter
  # as the final race backstop; the bounded outer wait still fails loudly when a
  # guest package manager is genuinely wedged.
  vm_run "$name" <<'EOF'
set -euo pipefail

wait_for_guest_apt_idle() {
  local deadline now clear_streak=0
  deadline=$(( $(date +%s) + 300 ))
  while true; do
    if sudo fuser \
      /var/lib/apt/lists/lock \
      /var/cache/apt/archives/lock \
      /var/lib/dpkg/lock-frontend \
      /var/lib/dpkg/lock >/dev/null 2>&1 \
      || pgrep -x apt >/dev/null 2>&1 \
      || pgrep -x apt-get >/dev/null 2>&1 \
      || pgrep -x dpkg >/dev/null 2>&1; then
      clear_streak=0
    else
      clear_streak=$((clear_streak + 1))
      [ "$clear_streak" -ge 2 ] && return 0
    fi

    now=$(date +%s)
    if [ "$now" -ge "$deadline" ]; then
      echo "timed out after 300s waiting for guest apt/dpkg locks" >&2
      return 1
    fi
    sleep 1
  done
}

command -v fuser >/dev/null 2>&1 \
  || { echo "fuser is required for bounded guest apt-lock coordination" >&2; exit 1; }
wait_for_guest_apt_idle
sudo apt-get update -qq
wait_for_guest_apt_idle
sudo DEBIAN_FRONTEND=noninteractive \
  apt-get -o DPkg::Lock::Timeout=300 install -y --reinstall /tmp/Papercusp.deb
EOF
  log "installed:"; vm_ssh "$name" "dpkg -l | grep -i papercusp || true"
}

cmd_launch() {
  local name="${1:-clean}"
  vm_running "$name" || die "$name is not running. vmctl up $name"
  require_federation_launch_context "$name"
  log "launching the app in $name's X session (display :0)…"
  # startx (getty autologin) runs the openbox session as tester on :0 and writes
  # the cookie to ~/.Xauthority, so this is deterministic — no session probing.
  vm_run "$name" <<'EOF'
export DISPLAY=:0
export XAUTHORITY="$HOME/.Xauthority"
for _ in $(seq 1 30); do xdpyinfo -display :0 >/dev/null 2>&1 && break; sleep 1; done
xdpyinfo -display :0 >/dev/null 2>&1 || { echo "X :0 not ready (see ~/startx.log)"; exit 1; }
# D-001 split-product invariant: the Server owns serve.mjs + embedded Postgres
# independently of the GUI. The old self-host-era cleanup killed those healthy
# Server children before every GUI launch, forcing systemd to restart the Server
# and racing the attach-only GUI against its replacement operator. Reap only a
# prior GUI process here; package/service lifecycle tests own Server teardown.
if pgrep -f '[p]apercusp-desktop' >/dev/null 2>&1; then
  echo "reaping prior Papercusp GUI process before launch…"
  pkill -9 -f '[p]apercusp-desktop' 2>/dev/null
  sleep 2
fi
# WI-6209: ~/fed.env carries PAPERCUSP_DHT_BOOTSTRAP (and the GH identity) on a
# federation VM. A relaunch that omits it does not fail — the app boots, peers,
# and logs normally — it just silently joins the PUBLIC DHT, pulling unrelated
# outside peers into a rig that is supposed to be isolated and invalidating every
# measurement taken from it. That cost real hours once; vm_assert_dht_isolated
# now DETECTS it, and sourcing it here removes the way to cause it. No-op on a
# plain VM, which has no fed.env.
if [ -f "$HOME/fed.env" ]; then
  set -a; . "$HOME/fed.env"; set +a
  echo "sourced ~/fed.env (DHT bootstrap + identity — this is a federation VM)"
fi
echo "launching with DISPLAY=$DISPLAY XAUTHORITY=$XAUTHORITY"
setsid bash -c 'exec /usr/bin/papercusp-desktop' >"$HOME/papercusp-app.log" 2>&1 </dev/null &
sleep 1; echo "started; log → ~/papercusp-app.log"
EOF
  log "app launching. Watch: vmctl ssh $name 'tail -f papercusp-app.log'  ·  view: vmctl gui $name"
}

# cmd_hotpatch — the fast inner loop for JS changes (WI-6212).
#
# `vmctl install` re-lays a full .deb: ~3.5GB of cargo work to change JavaScript
# that bin/build-desktop-sidecar.sh rebuilds by itself in minutes. Everything
# federation/sync/operator lives in that bundle, so this is the loop that
# actually gets used — the Hetzner rig has had it as RIG_SERVE_HOTPATCH for a
# long time and the local rig was the one left hand-rolling scp (WI-6209).
#
# Push + relaunch are ONE command on purpose: a hotpatch without a relaunch
# changes nothing (node read the old bundle at startup), and a "did it take
# effect?" that depends on remembering a second step is a footgun on a rig whose
# entire failure mode is confidently measuring the wrong bytes.
cmd_hotpatch() {
  local name="${1:-clean}" src="${2:-${RIG_SERVE_HOTPATCH:-$DESKTOP_REPO/src-tauri/sidecar/serve.mjs}}" before after hp expected
  vm_running "$name" || die "$name is not running. vmctl up $name"
  require_federation_launch_context "$name"
  [ -f "$src" ] || die "no sidecar bundle to hotpatch at '$src'"
  expected="$(sha256sum "$src" | cut -d' ' -f1)"
  # A GUI relaunch deliberately leaves the Server alone. Qualify its supported
  # user-service ownership BEFORE copying anything; never fall back to pkill.
  before="$(vm_server_loaded_identity "$name" ownership)" \
    || die "cannot identify the service-owned Server on '$name'; no hotpatch applied"
  vm_hotpatch_sidecar "$name" "$src"
  hp="$(vm_hotpatch_provenance "$name")"
  [ -n "$hp" ] || die "hotpatch disk provenance missing on '$name'; Server reload refused"
  [ "${hp%%|*}" = "${expected:0:12}" ] \
    || die "hotpatch disk provenance differs from intended source on '$name'"
  log "restarting the Server user service to load the hotpatched bundle…"
  vm_run "$name" <<'EOF'
set -euo pipefail
timeout 60s systemctl --user restart papercusp-server.service
EOF
  # Startup can include migrations. Every attempt and the overall wait are
  # bounded; an old discovery record or service invocation cannot satisfy it.
  local deadline=$(( $(date +%s) + 120 ))
  while :; do
    after="$(vm_server_loaded_identity "$name" 2>/dev/null)" || after=""
    if [ -n "$after" ] && [ "${after%%|*}" != "${before%%|*}" ] \
       && [ "${after##*|}" != "${before##*|}" ]; then
      local loaded="${after#*|}"; loaded="${loaded%%|*}"
      [ "$loaded" = "$expected" ] \
        || die "Server loaded identity differs from hotpatch disk provenance on '$name'; GUI not relaunched"
      break
    fi
    [ "$(date +%s)" -lt "$deadline" ] \
      || die "Server reload on '$name' did not establish a new loaded identity; GUI not relaunched"
    sleep 2
  done
  cmd_launch "$name"
  log "hotpatched + Server reload verified ($after); GUI relaunched"
}

# ── destructive updater/revert E2E preparation ────────────────────────────
# This is the canonical door for clicking Update / Revert. It deliberately
# resets a DEDICATED VM, copies only the baseline AppImage, creates a brand-new
# HOME inside the guest, and proves the guest has a different kernel boot id.
# No host ~/.papercusp state, pid file, console marker, heartbeat, socket, or
# embedded database is copied. Even a catastrophic cleanup bug can therefore
# signal only guest processes.
cmd_updater_e2e() {
  local appimage="${1:-}" name="${2:-updater}"
  local release_host="${PAPERCUSP_E2E_RELEASE_HOST:-http://10.0.2.2:8043}"
  local runtime_deb="${PAPERCUSP_E2E_RUNTIME_DEB:-}"
  [ -n "$appimage" ] && [ -f "$appimage" ] \
    || die "usage: vmctl updater-e2e <baseline.AppImage> [updater|updater-N]"
  case "$name" in
    updater|updater-[A-Za-z0-9_-]*) ;;
    *) die "updater-e2e may reset only the dedicated updater/updater-* VM lane (got '$name')" ;;
  esac
  [[ "$release_host" =~ ^https?://[^[:space:]\']+$ ]] \
    || die "PAPERCUSP_E2E_RELEASE_HOST must be an http(s) URL without whitespace or quotes"

  local host_boot guest_boot guest_virt release_host_q
  host_boot="$(cat /proc/sys/kernel/random/boot_id)"
  log "resetting dedicated $name overlay — updater/revert E2E always starts from pristine state"
  cmd_reset "$name"
  cmd_up "$name"

  guest_virt="$(vm_ssh "$name" 'systemd-detect-virt 2>/dev/null || true')"
  [ -n "$guest_virt" ] && [ "$guest_virt" != "none" ] \
    || die "$name did not prove it is virtualized; refusing destructive updater E2E"
  guest_boot="$(vm_ssh "$name" 'cat /proc/sys/kernel/random/boot_id')"
  [ -n "$guest_boot" ] && [ "$guest_boot" != "$host_boot" ] \
    || die "$name shares the host kernel boot id; refusing destructive updater E2E"
  log "PID boundary proved: host boot $host_boot != guest boot $guest_boot ($guest_virt)"

  # The AppImage intentionally relies on system WebKit/GTK. A pristine golden
  # does not carry those libraries; install the existing desktop .deb first to
  # provision the runtime dependency set, then launch the AppImage from the
  # separate empty HOME so the updater still exercises AppImage self-swap.
  [ -n "$runtime_deb" ] || runtime_deb="$(default_deb)"
  [ -n "$runtime_deb" ] && [ -f "$runtime_deb" ] \
    || die "no runtime .deb available; set PAPERCUSP_E2E_RUNTIME_DEB=/path/to/Papercusp.deb"
  log "installing runtime dependencies from $(basename "$runtime_deb")"
  cmd_install "$name" "$runtime_deb"

  vm_scp "$name" "$appimage" /tmp/Papercusp-updater-baseline.AppImage
  printf -v release_host_q '%q' "$release_host"
  vm_ssh "$name" \
    "PAPERCUSP_E2E_RELEASE_HOST=$release_host_q PAPERCUSP_E2E_HOST_BOOT=$host_boot bash -s" <<'EOF'
set -euo pipefail
real_home="$HOME"
e2e_root="$real_home/updater-e2e"
e2e_home="$e2e_root/home"
appimage="$e2e_root/bin/Papercusp.AppImage"

# The reset above is the primary state scrub. This second boundary creates an
# empty app HOME and refuses every live-state copying pattern that caused the
# 2026-07-16 incident.
rm -rf "$e2e_root"
mkdir -p "$e2e_home" "$e2e_root/bin" "$e2e_root/config" "$e2e_root/data" "$e2e_root/cache"
install -m 0755 /tmp/Papercusp-updater-baseline.AppImage "$appimage"
for forbidden in \
  "$e2e_home/.papercusp/operator.json" \
  "$e2e_home/.papercusp/embedded-pg.json" \
  "$e2e_home/.papercusp/endpoint-ipc.json" \
  "$e2e_home/.papercusp/sockets" \
  "$e2e_home/.papercup-console-active."*; do
  [ ! -e "$forbidden" ] || { echo "forbidden PID-bearing seed: $forbidden" >&2; exit 1; }
done

export DISPLAY=:0
export XAUTHORITY="$real_home/.Xauthority"
for _ in $(seq 1 30); do xdpyinfo -display :0 >/dev/null 2>&1 && break; sleep 1; done
xdpyinfo -display :0 >/dev/null 2>&1 || { echo "guest X :0 is not ready" >&2; exit 1; }

setsid env \
  HOME="$e2e_home" \
  XDG_CONFIG_HOME="$e2e_root/config" \
  XDG_DATA_HOME="$e2e_root/data" \
  XDG_CACHE_HOME="$e2e_root/cache" \
  XDG_RUNTIME_DIR="/run/user/$(id -u)" \
  DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" \
  PAPERCUSP_RELEASE_HOST="$PAPERCUSP_E2E_RELEASE_HOST" \
  PAPERCUSP_E2E=1 PAPERCUSP_E2E_PID_ISOLATED=1 \
  "$appimage" >"$e2e_root/app.log" 2>&1 </dev/null &
echo $! >"$e2e_root/launcher.pid"

# Persist the kernel-isolation evidence before inspecting the artifact. A
# deliberately old baseline may fail the birth-identity gate below; that must
# not erase proof that the destructive test itself ran outside the host PID
# namespace. operatorIdentityVerified flips true only after the live procfs
# comparison succeeds.
printf '{"pidIsolated":true,"hostBoot":"%s","guestBoot":"%s","operatorIdentityVerified":false}\n' \
  "$PAPERCUSP_E2E_HOST_BOOT" "$(cat /proc/sys/kernel/random/boot_id)" \
  >"$e2e_root/isolation-proof.json"

# Wait for the guest operator record, then prove its recorded birth identity
# matches the guest kernel. This is also the live guard for the stale-PID fix.
for _ in $(seq 1 120); do
  [ -s "$e2e_home/.papercusp/operator.json" ] && break
  sleep 2
done
[ -s "$e2e_home/.papercusp/operator.json" ] \
  || { tail -80 "$e2e_root/app.log" >&2; echo "guest operator did not start" >&2; exit 1; }
python3 - "$e2e_home/.papercusp/operator.json" <<'PY'
import json, pathlib, sys
record = json.loads(pathlib.Path(sys.argv[1]).read_text())
pid = int(record["pid"])
boot = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()
stat = pathlib.Path(f"/proc/{pid}/stat").read_text()
fields = stat[stat.rfind(")") + 1:].split()
expected = f"linux:{boot}:{fields[19]}"
actual = record.get("processIdentity")
if not actual:
    raise SystemExit(
        "operator record has no processIdentity; this artifact predates the "
        "stale-PID cleanup fix and is rejected. Rebuild the AppImage."
    )
if actual != expected:
    raise SystemExit(f"operator birth identity mismatch: recorded={actual!r} expected={expected!r}")
PY
printf '{"pidIsolated":true,"hostBoot":"%s","guestBoot":"%s","operatorIdentityVerified":true}\n' \
  "$PAPERCUSP_E2E_HOST_BOOT" "$(cat /proc/sys/kernel/random/boot_id)" \
  >"$e2e_root/isolation-proof.json"
EOF

  log "updater/revert baseline is running in the $name VM with an empty HOME"
  log "release host: $release_host"
  log "drive it only through: vmctl gui $name  (Update, verify relaunch, then Revert)"
  log "guest evidence: ~/updater-e2e/isolation-proof.json and ~/updater-e2e/app.log"
}

cmd_gui() {
  local name="${1:-clean}"
  local spice; spice="$(ports_for "$name" | awk '{print $2}')"
  log "opening SPICE viewer → spice://127.0.0.1:$spice (close the window to disconnect)"
  exec remote-viewer "spice://127.0.0.1:$spice"
}

# Paste exact text into the currently focused guest field without routing special
# characters through xdotool's keyboard parser. This is the reliable path for
# connection-gate URLs: `xdotool type` can corrupt/truncate URL punctuation on
# the VM's X11 path, while clipboard paste preserves the bytes. Capture the
# post-paste framebuffer before the caller submits the form, so a failed remote
# navigation can be distinguished from a malformed test-driver input.
cmd_gui_paste() {
  local name="${1:-clean}" text="${2:-}" out="${3:-}"
  [ -n "$text" ] || die "usage: vmctl gui-paste [name] TEXT [screenshot.ppm]"
  vm_running "$name" || die "$name is not running. vmctl up $name"
  [ -n "$out" ] || out="$(vm_rundir "$name")/gui-paste.ppm"
  mkdir -p "$(dirname "$out")"

  # Pass only base64 into the guest script: even a URL containing shell
  # metacharacters remains data, never remote shell syntax.
  local encoded; encoded="$(printf '%s' "$text" | base64 -w0)"
  log "pasting ${#text} bytes into the focused guest field (no submit)"
  vm_run "$name" "CLIPBOARD_B64=$encoded" <<'EOF'
set -euo pipefail
export DISPLAY=:0
export XAUTHORITY="$HOME/.Xauthority"
command -v xclip >/dev/null 2>&1 || { echo "xclip is required in the guest for exact GUI paste" >&2; exit 1; }
command -v xdotool >/dev/null 2>&1 || { echo "xdotool is required in the guest for GUI paste" >&2; exit 1; }
active_window="$(xdotool getactivewindow 2>/dev/null || true)"
[ -n "$active_window" ] || { echo "no active guest X11 window; focus the target field before gui-paste" >&2; exit 1; }
printf '%s' "$CLIPBOARD_B64" | base64 -d | xclip -selection clipboard -in
xdotool key --window "$active_window" --clearmodifiers ctrl+v
EOF

  screenshot "$name" "$out" || die "could not capture the post-paste guest framebuffer: $out"
  log "post-paste screenshot captured → $out (submit separately after inspecting it)"
}

# A QEMU screendump can be a syntactically valid, full-size PPM whose payload is
# entirely black while the guest X framebuffer is healthy (observed on the QXL
# clean VM during WI-40443). Nonempty is therefore not evidence. Parse only the
# tiny Netpbm header, then require at least one visible pixel byte.
ppm_has_visible_pixels() {  # ppm_has_visible_pixels <image.ppm>
  python3 - "$1" <<'PY'
from pathlib import Path
import sys

data = Path(sys.argv[1]).read_bytes()
offset = 0
tokens = []
while len(tokens) < 4:
    while offset < len(data) and data[offset] in b" \t\r\n":
        offset += 1
    if offset < len(data) and data[offset] == ord("#"):
        end = data.find(b"\n", offset)
        offset = len(data) if end < 0 else end + 1
        continue
    end = offset
    while end < len(data) and data[end] not in b" \t\r\n":
        end += 1
    tokens.append(data[offset:end])
    offset = end

if tokens[0] != b"P6":
    raise SystemExit(1)
while offset < len(data) and data[offset] in b" \t\r\n":
    offset += 1
raise SystemExit(0 if any(data[offset:]) else 1)
PY
}

# ── screenshot via qemu, with a real-framebuffer guest fallback ────────────
screenshot() {  # screenshot <name> <out.ppm>
  local name="$1" out="$2" mon; mon="$(vm_monitor "$name")"
  [ -S "$mon" ] || { warn "no monitor socket for $name"; return 1; }
  if command -v socat >/dev/null; then
    printf 'screendump %s\n' "$out" | socat - "UNIX-CONNECT:$mon" >/dev/null 2>&1
    if [ -s "$out" ] && ppm_has_visible_pixels "$out"; then
      return 0
    fi
    warn "qemu screendump was empty/all-black — falling back to guest X framebuffer"
  fi
  # scrot inside the guest sees the real X framebuffer even when QXL's monitor
  # surface is black. Keep PPM output so callers receive the path they requested.
  vm_run "$name" >/dev/null 2>&1 <<'EOF' || return 1
export DISPLAY=:0 XAUTHORITY="$HOME/.Xauthority"
scrot -o /tmp/shot.ppm
EOF
  vm_scp_back "$name" /tmp/shot.ppm "$out" || return 1
  ppm_has_visible_pixels "$out"
}
vm_scp_back() { local name="$1" src="$2" dst="$3" p; p="$(ports_for "$name"|awk '{print $1}')"; scp $(_ssh_opts) -P "$p" "$VM_USER@127.0.0.1:$src" "$dst"; }

# ── verify (P-005) ─────────────────────────────────────────────────────────
# Probe an in-guest loopback HTTP port; any status (even 404) = responding, 000 = down.
op_responds() {  # op_responds <name> <port>
  local name="$1" port="$2" code
  code="$(vm_run "$name" <<EOF
curl -s -m8 -o /dev/null -w '%{http_code}' http://127.0.0.1:$port/ 2>/dev/null || true
EOF
)"
  [ -n "$code" ] && [ "$code" != "000" ]
}

# Resolve the in-guest operator's chosen (DYNAMIC) port. Authoritative source is
# ~/.papercusp/operator.json (the app writes {port,pid,httpUrl,…} there on boot —
# `vmctl launch` + the A/B rigs already read it). The old method — grepping
# papercusp-app.log for a "[serve] listening on …" line — is STALE: the packaged
# build routes serve.mjs's stdout elsewhere, so the app log only carries the tauri
# binary's libEGL warnings and the grep found nothing → a false "operator down" on a
# perfectly healthy install (WI-2902, 2026-07-06). Read operator.json first; keep the
# log-grep as a fallback for any pre-operator.json build.
op_port() {  # op_port <name>  → prints the operator port (empty if unknown)
  local name="$1" p operator_json='~/.papercusp/operator.json'
  # updater-e2e deliberately launches the AppImage with an isolated HOME, so
  # its discovery record lives below ~/updater-e2e/home rather than the normal
  # guest home. Keep the lane choice here so status and verify share one source
  # of truth without changing the app's isolation boundary.
  case "$name" in
    updater|updater-*) operator_json='~/updater-e2e/home/.papercusp/operator.json' ;;
  esac
  p="$(vm_ssh "$name" "python3 -c \"import json,os;print(json.load(open(os.path.expanduser('$operator_json')))['port'])\" 2>/dev/null" 2>/dev/null | tr -dc '0-9')"
  [ -n "$p" ] && { printf '%s\n' "$p"; return 0; }
  vm_ssh "$name" "grep -oE 'listening on http://127\.0\.0\.1:[0-9]+' papercusp-app.log 2>/dev/null | grep -oE '[0-9]+\$' | tail -1" 2>/dev/null
}

# Read an xwininfo -root -tree body from stdin and accept only the real main
# window: title exactly "Papercusp" and at least the app's configured 800x600
# minimum. The tray/server placeholder is a 10x10 window named
# "papercusp-desktop"; accepting a process or any X11 child let vmctl verify
# false-green while the framebuffer contained only an unrelated xmessage.
papercusp_window_tree_has_main() {
  awk '
    /"Papercusp":/ {
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^[0-9]+x[0-9]+[+-]/) {
          split($i, dimensions, /[x+-]/)
          if (dimensions[1] >= 800 && dimensions[2] >= 600) found = 1
        }
      }
    }
    END { exit(found ? 0 : 1) }
  '
}

guest_papercusp_window_visible() {  # guest_papercusp_window_visible <name>
  local name="$1"
  vm_ssh "$name" \
    'export DISPLAY=:0 XAUTHORITY="$HOME/.Xauthority"; xwininfo -root -tree 2>/dev/null' \
    2>/dev/null | papercusp_window_tree_has_main
}

cmd_verify() {
  local name="${1:-clean}"
  vm_running "$name" || die "$name is not running. vmctl up $name"
  set +e   # this function probes a lot; don't let a non-zero probe abort it
  local out; out="$(vm_rundir "$name")/verify"; mkdir -p "$out"
  local pass=0 fail=0
  check() { if eval "$2"; then echo "  ✓ $1"; pass=$((pass+1)); else echo "  ✗ $1"; fail=$((fail+1)); fi; }

  echo "── fresh-install verification: $name ──"
  check "package installed (dpkg)"           "vm_ssh '$name' 'dpkg -l | grep -qi papercusp' 2>/dev/null"
  check "no missing deps (apt-get check)"    "vm_ssh '$name' 'sudo apt-get -s check >/dev/null 2>&1'"
  check "installed binary links cleanly"     "! vm_ssh '$name' 'ldd /usr/bin/papercusp-desktop 2>/dev/null | grep -qi \"not found\"' 2>/dev/null"

  # Ensure the app is running; if not, launch it.
  if ! vm_ssh "$name" 'pgrep -f [p]apercusp-desktop >/dev/null' 2>/dev/null; then
    log "app not running — launching for verification"; cmd_launch "$name"
  fi
  # Poll for the operator to come up (it picks a DYNAMIC port, not 3070; read from
  # operator.json via op_port). Up to 300s: a PRISTINE first boot with the bundled
  # hive seed restores a ~2GB corestore + runs migrations before serving health, and
  # was measured at ~3min process-start→health-200 (WI-2902) — 120s was too short and
  # falsely failed the check. Stop early if the embedded-PG spawn fatally fails.
  log "waiting for embedded Postgres + operator (cold-seed first boot can take ~3min)…"
  local op="" _i
  for _i in $(seq 1 60); do
    vm_ssh "$name" "cat papercusp-app.log 2>/dev/null" > "$out/app.log" 2>/dev/null || true
    grep -q 'failed to spawn embedded-postgres-server' "$out/app.log" && break
    op="$(op_port "$name")"
    [ -n "$op" ] && op_responds "$name" "$op" && break
    sleep 5
  done

  check "app process running"                "vm_ssh '$name' 'pgrep -f [p]apercusp-desktop >/dev/null' 2>/dev/null"
  # D-009/P-011: package name and executable path do not prove the configured
  # Tauri role. A Server-configured binary repacked as papercusp-gui installs
  # cleanly but logs role=server, creates only the 10x10 tray placeholder, and
  # can never map the GUI webview. Read the writer's runtime log before accepting
  # any window/process evidence.
  # WI-10003664: the GUI's writer (main.rs redirect_own_stdio under
  # workspaces::shared_sidecar_home()) lands gui.log in the per-workspace state
  # dir since 0.0.22 (~/.papercusp-workspaces/<ws>/.papercusp/logs/gui.log), not
  # ~/.papercusp/logs — reading only the legacy path false-failed every fresh
  # install. Search both; the exact-line match is unchanged.
  check "GUI runtime role + bundle identifier" \
    "vm_ssh '$name' 'grep -Fqs \"[papercusp-desktop] role=gui (identifier com.papercusp.gui)\" \"\$HOME/.papercusp/logs/gui.log\" \"\$HOME\"/.papercusp-workspaces/*/.papercusp/logs/gui.log' 2>/dev/null"
  # PG ready = a postgres serving the embedded data dir is actually running.
  check "embedded Postgres running"          "vm_ssh '$name' 'pgrep -af [p]ostgres 2>/dev/null | grep -q embedded-pg-data' 2>/dev/null"
  if [ -n "$op" ] && op_responds "$name" "$op"; then
    echo "  ✓ operator responds (port $op)"; pass=$((pass+1))
  else
    echo "  ✗ operator responds${op:+ (port $op)}"; fail=$((fail+1))
  fi

  # Operator health is not visible-window health. The Linux GUI's cold start can
  # take a little longer to map its 1280x800 webview after the sidecar becomes
  # reachable, so give the actual window a bounded settle budget and validate its
  # title + geometry. This rejects the tray/server 10x10 placeholder and unrelated
  # dialogs even when the process, PG, and HTTP checks are all green.
  local window_visible=0
  for _i in $(seq 1 24); do
    if guest_papercusp_window_visible "$name"; then window_visible=1; break; fi
    sleep 5
  done
  if [ "$window_visible" -eq 1 ]; then
    echo "  ✓ Papercusp main window visible (>=800x600)"; pass=$((pass+1))
  else
    echo "  ✗ Papercusp main window visible (>=800x600)"; fail=$((fail+1))
  fi

  if screenshot "$name" "$out/screen.ppm"; then
    echo "  ✓ screenshot captured → $out/screen.ppm"; pass=$((pass+1))
  else
    echo "  ✗ screenshot"; fail=$((fail+1))
  fi

  # Surface the smoking gun if anything below the install checks failed.
  if [ "$fail" -gt 0 ]; then
    echo "── app log diagnostics (FATAL/error/panic lines) ──"
    grep -iE 'FATAL|panicked|ECONNREFUSED|failed to spawn|did not start' "$out/app.log" | sed 's/^/    /' | head -12
  fi

  echo "── result: $pass passed, $fail failed · artifacts in $out ──"
  [ "$fail" -eq 0 ]
}

# ── status ─────────────────────────────────────────────────────────────────
cmd_status() {
  local name="${1:-clean}"
  # A stopped ad-hoc instance has no ports (WI-10004354); status only prints them when running.
  read -r ssh_port spice_port op_port <<<"$(ports_for "$name" 2>/dev/null || true)"
  echo "instance:   $name"
  echo "golden:     $([ -f "$GOLDEN" ] && echo present || echo MISSING)"
  echo "overlay:    $([ -f "$(vm_overlay "$name")" ] && echo present || echo none)"
  if vm_running "$name"; then
    echo "qemu:       running (pid $(vm_pid "$name"))  ssh:$ssh_port spice:127.0.0.1:$spice_port"
    if vm_ssh "$name" true 2>/dev/null; then
      echo "ssh:        reachable"
      echo "app:        $(vm_ssh "$name" 'pgrep -f [p]apercusp-desktop >/dev/null && echo running || echo stopped' 2>/dev/null)"
      # split-brain visibility (D-024): >1 desktop = duplicate launch; serve.mjs>0 with
      # "app: stopped" = an orphaned operator survived the GUI's death (reap before
      # relaunch — `vmctl launch` now auto-reaps). One healthy operator = 1 desktop +
      # a couple serve.mjs (operator + sidecar), so judge by the desktop count.
      local ndesk nsrv
      # pgrep -c already prints a single 0 when there are no matches, but exits
      # non-zero. Do not append an echo fallback: that turns one scalar into
      # two lines and breaks the status record's shape.
      ndesk="$(vm_ssh "$name" 'pgrep -cf [p]apercusp-desktop 2>/dev/null || true' 2>/dev/null)"
      nsrv="$(vm_ssh "$name" 'pgrep -cf [s]erve.mjs 2>/dev/null || true' 2>/dev/null)"
      echo "procs:      desktop=${ndesk:-?} serve.mjs=${nsrv:-?}$([ "${ndesk:-0}" -gt 1 ] 2>/dev/null && echo '  ⚠ DUPLICATE desktop — split-brain')"
      # operator runs on a DYNAMIC port — resolve it from operator.json (op_port), not
      # the app log (the packaged build doesn't log the "listening" line there).
      local op; op="$(op_port "$name")"
      if [ -n "$op" ] && op_responds "$name" "$op"; then
        echo "operator:   up (port $op)"
      elif [ -n "$op" ]; then
        echo "operator:   down (port $op)"
      else
        echo "operator:   not started (run: vmctl launch $name)"
      fi
      echo "disk:       $(vm_ssh "$name" "df -h / | awk 'NR==2{print \$4\" free of \"\$2}'" 2>/dev/null)"
    else
      echo "ssh:        not reachable yet"
    fi
  else
    echo "qemu:       stopped"
  fi
}

# ── machine-readable endpoint (WI-10004052) ───────────────────────────────
# The release platform-smoke gate and install-and-relaunch-verify.sh used to
# carry their OWN hard-coded SSH endpoint (the Windows VM's :2223 +
# papercup-vm-win key), so the Linux leg dialled the wrong machine on every
# release. Other tools now DERIVE this VM's endpoint from here — ports_for +
# SSH_KEY + VM_USER stay the single source of truth, env overrides included.
cmd_endpoint() {
  local name="${1:-clean}" ssh_port
  ssh_port="$(ports_for "$name" | awk '{print $1}')"
  printf 'ssh_port=%s\n' "$ssh_port"
  printf 'ssh_key=%s\n' "$SSH_KEY"
  printf 'ssh_host=%s@127.0.0.1\n' "$VM_USER"
}

cmd_is_running() { vm_running "${1:-clean}"; }

# cmd_up only WARNS when SSH is late; an automated caller needs a hard verdict.
cmd_wait_ssh() {
  local name="${1:-clean}" budget="${2:-300}"
  [[ "$budget" =~ ^[1-9][0-9]*$ ]] || die "wait-ssh budget must be a positive integer (got '$budget')"
  vm_running "$name" || die "$name is not running. vmctl up $name"
  wait_ssh "$name" "$budget" || die "SSH on $name did not answer within ${budget}s — see $(vm_serial "$name")"
}

cmd_help() {
  awk '
    NR == 1 { next }
    /^#/ {
      sub(/^# ?/, "")
      print
      next
    }
    { exit }
  ' "$SELF_DIR/vmctl"
}

# ── dispatch ───────────────────────────────────────────────────────────────
# Hermetic regression tests source the real predicates without touching a VM.
if [ "${PAPERCUSP_VMCTL_SOURCE_ONLY:-0}" = 1 ]; then
  return 0 2>/dev/null || exit 0
fi

cmd="${1:-help}"; shift || true
case "$cmd" in
  provision) cmd_provision "$@" ;;
  up)        cmd_up "$@" ;;
  down)      cmd_down "$@" ;;
  reset)     cmd_reset "$@" ;;
  ssh)       cmd_ssh "$@" ;;
  install)   cmd_install "$@" ;;
  launch)    cmd_launch "$@" ;;
  hotpatch)  cmd_hotpatch "$@" ;;
  updater-e2e) cmd_updater_e2e "$@" ;;
  gui)       cmd_gui "$@" ;;
  gui-paste) cmd_gui_paste "$@" ;;
  verify)    cmd_verify "$@" ;;
  status)    cmd_status "$@" ;;
  endpoint)  cmd_endpoint "$@" ;;
  is-running) cmd_is_running "$@" ;;
  wait-ssh)  cmd_wait_ssh "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command: $cmd (try: vmctl help)" ;;
esac
