#!/usr/bin/env bash
# Launch the desktop app in DEV mode WITHOUT HMR.
#
# NOTE: nohmr / :3070 is now the DEFAULT devUrl in tauri.conf.json, so this
# explicit override is redundant — it's kept for clarity / self-documentation.
# HMR is the explicit opt-in: `npm run dev:hmr` (devUrl http://localhost:3055,
# Vite dev server with the HMR client active).
#
# Why nohmr / :3070 is the default:
#   - The Tauri shell is the product surface and this checkout is edited by a
#     FLEET of agents at once. A Vite dev server (:3055) reloads the webview on
#     fleet edits / dep re-optimization / proxy errors while :3070 redeploys,
#     so the window "constantly refreshes". :3070 serves a STATIC bundle that
#     only changes on a release deploy — no dev-server reload pressure.
#   - Mirrors the prod runtime path exactly (Hono host + static dist).
#   - No `ws://localhost:3055/?token=…` HMR socket competing with SSE for the
#     libsoup 6-connection budget.
#
# Post-cutover (2026-06-06) topology — what :3070 actually serves:
#   :3070 = the GREEN release operator (papercup-dev-api, runs from the
#   papercup-release checkout, pinned to green `main`). Its dist is FROZEN
#   between release deploys (≤15min, green-gated) — you see SHIPPED state.
#   To watch latest *staging* work instead, point devUrl at :3170 (the
#   staging operator, which IS fed by `vite build --watch`); it's nohmr too,
#   so it updates on a manual Ctrl-R, not on every edit.
#
# Cost: manual reload (Cmd-R / Ctrl-R in the Tauri webview) to pick up a new
# deploy.

set -euo pipefail
cd "$(dirname "$0")/.."

# tauri dev --config takes a JSON5 string and merges it over tauri.conf.json.
# We only override devUrl; everything else stays the same.
exec npm run tauri -- dev --config '{"build":{"devUrl":"http://localhost:3070"}}'
